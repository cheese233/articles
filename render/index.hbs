<!doctype html>
<html lang="zh-CN">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        <meta name="description" content="" />
        <title>cheese233's blog</title>
        <link rel="icon" href="/render/favicon.svg" type="image/svg+xml" />
        <link rel="stylesheet" href="/render/style.css" />
        <link
            rel="alternate"
            type="application/atom+xml"
            title="Atom"
            href="/atom.xml"
        />
        <link
            rel="alternate"
            type="application/feed+json"
            title="JSON Feed"
            href="/feed.json"
        />
        <script type="importmap">
            {{{ importmap }}}
        </script>
    </head>
    <body>
        <div class="loader" aria-hidden="true"></div>
        <header class="site-header">
            <fluent-link class="site-title" href="/" appearance="subtle">
                <span class="site-mark" aria-hidden="true">✦</span>
                <span data-site-title>cheese233's blog</span>
            </fluent-link>
            <nav class="site-nav">
                <fluent-link href="/">Home</fluent-link>
                <fluent-link href="/atom.xml" data-raw>Atom</fluent-link>
                <fluent-link href="/feed.json" data-raw>JSON</fluent-link>
                <fluent-link
                    href="https://codeberg.org/cheese233/articles"
                    target="_blank"
                    rel="noopener"
                >Source</fluent-link>
            </nav>
        </header>
        <main id="main" aria-live="polite"></main>
        <fluent-divider></fluent-divider>
        <footer class="site-footer">
            <span data-site-title>cheese233's blog</span>
            <span class="footer-note">
                rendered from source in your browser
            </span>
        </footer>
        <noscript>
            <div class="noscript">
                <dialog open>
                    <h2>JavaScript required</h2>
                    <p>
                        Every page is rendered from its source file in the
                        browser. Please enable JavaScript.
                    </p>
                    <p>
                        You can still read the files under
                        <a href="/">/</a>.
                    </p>
                </dialog>
            </div>
        </noscript>
        <script type="module" src="/render/boot.js"></script>
    </body>
</html>
