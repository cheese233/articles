{
  "name": "articles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A client-rendered blog whose pages are generated in the browser from source files.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "metadata": "node scripts/metadata.ts",
    "bundle": "node scripts/bundle.ts",
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts && node scripts/dev.ts",
    "typecheck": "tsc --noEmit",
    "test": "web-test-runner",
    "test:watch": "web-test-runner --watch",
    "deploy": "node scripts/build.ts && node scripts/deploy.ts",
    "prepare": "node scripts/sync_git_exclude.ts",
    "hooks": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "node scripts/sync_git_exclude.ts --staged"
  },
  "dependencies": {
    "fast-xml-builder": "^1.3.1",
    "fluentui-webcomponents": "git+https://github.com/cheese233/fluentui-webcomponents.git#c094ae7",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "ts-blank-space": "^0.9.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-chrome": "^1.0.1",
    "@web/test-runner-commands": "^1.0.1",
    "es-module-lexer": "^3.0.4",
    "handlebars": "^4.7.10",
    "mime": "^4.1.1",
    "rolldown": "^1.2.15",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "allowScripts": {
    "simple-git-hooks": true
  }
}
